# PostgreSQL shared by every application instance. Use your provider's TLS settings.
DATABASE_URL=postgresql://poker:poker_local_only@localhost:5432/poker
# Exact public origin, without a trailing slash. Required behind a reverse proxy.
APP_ORIGIN=http://localhost:3000

# Hosted operations require an exact remote HTTPS APP_ORIGIN and a dedicated
# PostgreSQL connection with sslmode=verify-full. Do not reuse local credentials.
# Disable BOTH prototype markers for real operations; leave the public demo separate.
# NEXT_PUBLIC_POKER_PROTOTYPE=0
# POKER_PROTOTYPE_MODE=0
# DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DATABASE_HOST/poker?sslmode=verify-full
# APP_ORIGIN=https://operations.example.com
# Run npm run production:check in the target environment before release.

# Per application instance. Budget all replicas against the provider connection limit.
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
