{
  "name": "poker-management-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "prototype": "node --import tsx scripts/prototype.ts",
    "local": "node --conditions=react-server --import tsx scripts/local.ts",
    "local:postgres": "node --conditions=react-server --import tsx scripts/local-postgres.ts --port 3001",
    "local:db": "node --conditions=react-server --import tsx scripts/local.ts --database-only",
    "local:seed": "node --conditions=react-server --import tsx scripts/seed-local.ts",
    "local:backup": "node --conditions=react-server --import tsx scripts/backup-local.ts backup",
    "local:restore": "node --conditions=react-server --import tsx scripts/backup-local.ts restore",
    "local:verify-backup": "node --conditions=react-server --import tsx scripts/backup-local.ts verify",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit:runtime": "yarn audit --groups dependencies",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:postgres": "node --conditions=react-server --import tsx --test tests/postgres.integration.ts",
    "test:operations-http": "node --conditions=react-server --import tsx --test tests/operations-http.integration.ts",
    "capacity:baseline": "node --conditions=react-server --import tsx scripts/capacity-baseline.ts",
    "capacity:mixed": "node --conditions=react-server --import tsx scripts/mixed-workload.ts",
    "recovery:drill": "node --conditions=react-server --import tsx scripts/recovery-drill.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "production:check": "node --import tsx scripts/check-production.ts",
    "db:migrate": "node --conditions=react-server --import tsx scripts/manage.ts migrate",
    "db:verify": "node --conditions=react-server --import tsx scripts/check-data.ts",
    "db:branch": "node --conditions=react-server --import tsx scripts/manage.ts branch",
    "staff:create": "node --conditions=react-server --import tsx scripts/manage.ts staff",
    "staff:password": "node --conditions=react-server --import tsx scripts/manage.ts password",
    "staff:disable": "node --conditions=react-server --import tsx scripts/manage.ts disable"
  },
  "dependencies": {
    "@dnd-kit/collision": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.95.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "3.14.2",
    "lucide-react": "^1.7.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/eslint-plugin-query": "^5.95.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.9",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
